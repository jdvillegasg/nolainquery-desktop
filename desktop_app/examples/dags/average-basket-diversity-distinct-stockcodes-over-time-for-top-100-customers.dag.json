  "python_code": "# Identify top 100 customers by total spending\ncustomer_spending = df.groupby('Customer ID')['Price'].sum().reset_index()\ncustomer_spending.columns = ['Customer ID', 'TotalSpending']\ntop_100_customers = customer_spending.nlargest(100, 'TotalSpending')['Customer ID'].tolist()\n\n# Filter data to only top 100 customers\ntop_customers_df = df[df['Customer ID'].isin(top_100_customers)].copy()\n\n# Convert InvoiceDate to datetime\ntop_customers_df['InvoiceDate'] = pd.to_datetime(top_customers_df['InvoiceDate'])\n\n# Extract date (without time) for grouping over time\ntop_customers_df['Date'] = top_customers_df['InvoiceDate'].dt.date\n\n# Calculate distinct StockCodes per invoice per date\nbasket_diversity = top_customers_df.groupby(['Date', 'Invoice'])['StockCode'].nunique().reset_index()\nbasket_diversity.columns = ['Date', 'Invoice', 'DistinctStockCodes']\n\n# Average basket diversity per date\nresult = basket_diversity.groupby('Date')['DistinctStockCodes'].mean().reset_index()\nresult.columns = ['Date', 'AvgBasketDiversity']"
