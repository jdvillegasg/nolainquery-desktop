  "python_code": "# Filter for United Kingdom customers with non-null Customer ID\nuk_customers = df[df['Country'] == 'United Kingdom'].copy()\nuk_customers = uk_customers.dropna(subset=['Customer ID'])\n\n# Calculate total spending per invoice (Quantity * Price)\nuk_customers['Spending'] = uk_customers['Quantity'] * uk_customers['Price']\n\n# Group by Customer ID and calculate mean and std of spending per customer\ncustomer_stats = uk_customers.groupby('Customer ID')['Spending'].agg(['mean', 'std']).reset_index()\n\n# Calculate coefficient of variation (std / mean), handle cases where mean is 0\ncustomer_stats['cv'] = customer_stats['std'] / customer_stats['mean']\ncustomer_stats['cv'] = customer_stats['cv'].fillna(0)  # If mean is 0, cv is undefined, treat as 0\n\n# Count customers with cv > 0.5\nresult = len(customer_stats[customer_stats['cv'] > 0.5])"
