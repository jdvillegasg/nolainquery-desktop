  "python_code": "# Filter for United Kingdom customers and drop rows with missing Customer ID or InvoiceDate\nuk_orders = df[df['Country'] == 'United Kingdom'].copy()\nuk_orders = uk_orders.dropna(subset=['Customer ID', 'InvoiceDate'])\n\n# Convert InvoiceDate to datetime\nuk_orders['InvoiceDate'] = pd.to_datetime(uk_orders['InvoiceDate'])\n\n# For each customer, get the sorted list of order dates (per invoice)\ncustomer_order_dates = uk_orders.groupby('Customer ID')['InvoiceDate'].apply(lambda x: x.sort_values().unique()).reset_index()\n\n# Compute the difference in days between consecutive orders for each customer\ndef avg_days_between_orders(dates):\n    if len(dates) < 2:\n        return None\n    diffs = (dates[1:] - dates[:-1]).astype('timedelta64[D]').astype(float)\n    return diffs.mean()\n\ncustomer_order_dates['avg_days'] = customer_order_dates['InvoiceDate'].apply(avg_days_between_orders)\n\n# Compute the overall average across all customers\nresult = customer_order_dates['avg_days'].mean()"
}
