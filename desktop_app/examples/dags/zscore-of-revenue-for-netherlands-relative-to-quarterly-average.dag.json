  "python_code": "# Calculate revenue per invoice (Quantity * Price)\ndf['Revenue'] = df['Quantity'] * df['Price']\n\n# Filter for Netherlands only\nnetherlands_df = df[df['Country'] == 'Netherlands'].copy()\n\n# Extract quarter from InvoiceDate\nnetherlands_df['Quarter'] = pd.to_datetime(netherlands_df['InvoiceDate']).dt.to_period('Q')\n\n# Calculate quarterly revenue for Netherlands\nquarterly_revenue_netherlands = netherlands_df.groupby('Quarter')['Revenue'].sum().reset_index()\nquarterly_revenue_netherlands.columns = ['Quarter', 'Netherlands_Revenue']\n\n# Calculate overall quarterly average revenue (all countries)\ndf['Quarter'] = pd.to_datetime(df['InvoiceDate']).dt.to_period('Q')\nquarterly_avg_all = df.groupby('Quarter')['Revenue'].sum().reset_index()\nquarterly_avg_all.columns = ['Quarter', 'Global_Quarterly_Revenue']\nglobal_quarterly_avg = quarterly_avg_all['Global_Quarterly_Revenue'].mean()\n\n# Merge and calculate Z-score\nmerged = quarterly_revenue_netherlands.merge(quarterly_avg_all, on='Quarter', how='left')\nmerged['Z_Score'] = (merged['Netherlands_Revenue'] - global_quarterly_avg) / merged['Global_Quarterly_Revenue'].std()\n\nresult = merged[['Quarter', 'Netherlands_Revenue', 'Z_Score']]"
}
