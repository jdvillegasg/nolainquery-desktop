  "python_code": "# Filter data for France only\nfrance_df = df[df['Country'] == 'France'].copy()\n\n# Calculate total quantity sold per product (StockCode) in France\nproduct_quantity = france_df.groupby('StockCode')['Quantity'].sum().reset_index()\nproduct_quantity.columns = ['StockCode', 'TotalQuantity']\n\n# Calculate average price per product in France\nproduct_price = france_df.groupby('StockCode')['Price'].mean().reset_index()\nproduct_price.columns = ['StockCode', 'AvgPrice']\n\n# Merge quantity and price data\nproduct_stats = product_quantity.merge(product_price, on='StockCode')\n\n# Sort by total quantity descending and take top 100 products\ntop_100_products = product_stats.sort_values('TotalQuantity', ascending=False).head(100).copy()\n\n# Calculate correlation between price and quantity for top 100 products\nresult = top_100_products['AvgPrice'].corr(top_100_products['TotalQuantity'])"
