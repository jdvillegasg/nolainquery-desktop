  "python_code": "# Filter for Australia and calculate revenue per transaction\naustralia_df = df[df['Country'] == 'Australia'].copy()\n\n# Calculate revenue for each row\naustralia_df['Revenue'] = australia_df['Quantity'] * australia_df['Price']\n\n# Convert InvoiceDate to datetime\naustralia_df['InvoiceDate'] = pd.to_datetime(australia_df['InvoiceDate'])\n\n# Set InvoiceDate as index for rolling window\naustralia_df = australia_df.set_index('InvoiceDate').sort_index()\n\n# Calculate daily revenue\ndaily_revenue = australia_df['Revenue'].resample('D').sum()\n\n# Calculate 7-day rolling average\nresult = daily_revenue.rolling(window=7, min_periods=1).mean().reset_index()\nresult.columns = ['InvoiceDate', '7_day_rolling_avg_revenue']"
