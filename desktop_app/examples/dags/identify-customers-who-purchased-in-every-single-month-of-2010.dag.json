  "python_code": "# Filter data for 2010 and drop rows with missing Customer ID\ndf_2010 = df[df['InvoiceDate'].str.startswith('2010')].copy()\ndf_2010 = df_2010.dropna(subset=['Customer ID'])\n\n# Extract month from InvoiceDate\ndf_2010['Month'] = df_2010['InvoiceDate'].str[5:7]\n\n# Group by Customer ID and count distinct months purchased\ncustomer_months = df_2010.groupby('Customer ID')['Month'].nunique().reset_index()\ncustomer_months.columns = ['Customer ID', 'num_months']\n\n# Identify customers who purchased in all 12 months of 2010\nresult = customer_months[customer_months['num_months'] == 12]['Customer ID'].tolist()"
