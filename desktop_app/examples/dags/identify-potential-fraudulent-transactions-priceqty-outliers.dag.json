  "python_code": "# Identify potential fraudulent transactions (price/qty outliers)\n# Approach: Flag transactions where Price or Quantity are extreme outliers using IQR method\n\n# Calculate unit price (Price per item) - already have Price column\n# Use IQR to detect outliers in Price and Quantity\n\n# Calculate Q1, Q3, and IQR for Price\nprice_q1 = df['Price'].quantile(0.25)\nprice_q3 = df['Price'].quantile(0.75)\nprice_iqr = price_q3 - price_q1\nprice_lower = price_q1 - 1.5 * price_iqr\nprice_upper = price_q3 + 1.5 * price_iqr\n\n# Calculate Q1, Q3, and IQR for Quantity\nqty_q1 = df['Quantity'].quantile(0.25)\nqty_q3 = df['Quantity'].quantile(0.75)\nqty_iqr = qty_q3 - qty_q1\nqty_lower = qty_q1 - 1.5 * qty_iqr\nqty_upper = qty_q3 + 1.5 * qty_iqr\n\n# Flag outliers\ndf_temp = df.copy()\ndf_temp['price_outlier'] = (df_temp['Price'] < price_lower) | (df_temp['Price'] > price_upper)\ndf_temp['qty_outlier'] = (df_temp['Quantity'] < qty_lower) | (df_temp['Quantity'] > qty_upper)\ndf_temp['fraud_flag'] = df_temp['price_outlier'] | df_temp['qty_outlier']\n\n# Filter to potential fraudulent transactions\nresult = df_temp[df_temp['fraud_flag']].copy()\n\n# Select relevant columns for output\nresult = result[['Invoice', 'StockCode', 'Description', 'Quantity', 'Price', 'Customer ID', 'Country', 'price_outlier', 'qty_outlier']].reset_index(drop=True)"
}
