  "python_code": "# Step 1: Identify top 10 products based on total quantity sold\ntop_products = (\n    df.groupby('StockCode')['Quantity']\n    .sum()\n    .nlargest(10)\n    .index\n)\n\n# Step 2: For each customer, get the set of products they purchased\ncustomer_products = (\n    df.dropna(subset=['Customer ID'])\n    .groupby('Customer ID')['StockCode']\n    .apply(set)\n    .reset_index()\n)\ncustomer_products.columns = ['Customer ID', 'purchased_products']\n\n# Step 3: Filter customers whose purchased products are a subset of top products\n# (i.e., they only buy top products, possibly not all of them)\ncustomer_products['only_top'] = customer_products['purchased_products'].apply(\n    lambda products: products.issubset(top_products) and len(products) > 0\n)\n\n# Step 4: Get the list of customer IDs that exclusively buy top products\nresult = customer_products.loc[customer_products['only_top'], 'Customer ID'].tolist()"
}
