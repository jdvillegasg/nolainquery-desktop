  "python_code": "# Filter data for 2009\ndf_2009 = df[df['InvoiceDate'].str.startswith('2009')].copy()\n\n# Calculate revenue per transaction (Price * Quantity)\ndf_2009['Revenue'] = df_2009['Price'] * df_2009['Quantity']\n\n# Remove rows with missing Customer ID or negative revenue (returns)\ndf_2009 = df_2009.dropna(subset=['Customer ID'])\ndf_2009 = df_2009[df_2009['Revenue'] > 0]\n\n# Calculate total revenue per customer\ncustomer_revenue = df_2009.groupby('Customer ID')['Revenue'].sum().reset_index()\ncustomer_revenue.columns = ['Customer ID', 'TotalRevenue']\n\n# Sort by revenue ascending for Gini calculation\ncustomer_revenue = customer_revenue.sort_values('TotalRevenue').reset_index(drop=True)\n\n# Calculate Gini coefficient\nn = len(customer_revenue)\nif n > 0:\n    total_revenue = customer_revenue['TotalRevenue'].sum()\n    cumulative_revenue = customer_revenue['TotalRevenue'].cumsum()\n    # Gini = (2 * sum(i * y_i) / (n * sum(y_i))) - (n + 1) / n\n    numerator = 2 * sum((i + 1) * y for i, y in enumerate(customer_revenue['TotalRevenue']))\n    denominator = n * total_revenue\n    gini = (numerator / denominator) - (n + 1) / n\n    result = gini\nelse:\n    result = None"
